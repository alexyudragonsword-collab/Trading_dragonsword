# Copy this file to .streamlit/secrets.toml and fill in values.
# secrets.toml is git-ignored — never commit the real file.
#
# On Streamlit Community Cloud: paste into App Settings → Secrets.

# Comma-separated list of admin emails.
# Admin users see an extra "管理后台" tab with the full user list.
ADMIN_EMAILS = "you@example.com,other@example.com"
