# Copy this file to .streamlit/secrets.toml and fill in your key.
# secrets.toml is git-ignored — never commit the real key.
#
# Get a free Alpha Vantage API key at:
#   https://www.alphavantage.co/support/#api-key
#
# On Streamlit Community Cloud: paste into App Settings → Secrets.

AV_API_KEY = "your_alpha_vantage_api_key_here"
